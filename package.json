{
  "name": "hermes-to-claude",
  "version": "0.2.15",
  "type": "module",
  "description": "Local HTTP bridge connecting Hermes Agent to Claude Code — no Pro/Max subscription required",
  "license": "MIT",
  "repository": "github:xuhancn/hermes-to-claude",
  "bin": {
    "h2c": "dist/h2c.mjs"
  },
  "files": [
    "dist/",
    "scripts/",
    "docs/",
    "DESIGN.md",
    "LICENSE",
    "README.md",
    "build.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/setup-mcp.cjs",
    "test": "node src/hermes_to_claude/transport/__tests__/run-all.mjs && node tests/test_bridge.mjs && node tests/test_e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "hermes",
    "claude",
    "claude-code",
    "h2c",
    "agent",
    "orchestrator",
    "bridge",
    "multi-agent",
    "ai-agent",
    "hermes-agent"
  ]
}
